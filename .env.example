# App
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=cambie_este_secreto_en_produccion
JWT_EXPIRES_IN=12h

# PINs demo (configurables). El seed los usa al crear los usuarios.
# Si no se definen, usa los defaults históricos (1234/1111/2222/3333/4444).
# CAMBIAR por valores propios antes de un piloto real (NO versionar los reales).
SEED_ADMIN_PIN=1234
SEED_MESERO_PIN=1111
SEED_COCINA_PIN=2222
SEED_BARRA_PIN=3333
SEED_CAJA_PIN=4444

# Supabase + Prisma
# Reemplace PROJECT_REF y YOUR_PASSWORD por los datos de Supabase.
# DATABASE_URL usa transaction pooler 6543.
# DIRECT_URL usa session pooler 5432 para migraciones.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Redis futuro / opcional
REDIS_URL=redis://localhost:6379

# Facturación mediante proveedor recomendado para producción
FACTURACION_PROVIDER_API_URL=
FACTURACION_PROVIDER_API_KEY=

# Hacienda directo / experimental
# Requiere XML firmado XAdES-EPES. Recomendado solo si se implementa firma completa.
HACIENDA_CEDULA=
HACIENDA_NOMBRE=
HACIENDA_NOMBRE_COMERCIAL=
HACIENDA_CODIGO_ACTIVIDAD=561010
HACIENDA_EMAIL=
HACIENDA_TELEFONO=
HACIENDA_PROVINCIA=1
HACIENDA_CANTON=01
HACIENDA_DISTRITO=01
HACIENDA_DIRECCION=Costa Rica
HACIENDA_USUARIO=
HACIENDA_PASSWORD=
HACIENDA_PIN=
HACIENDA_SANDBOX=true
